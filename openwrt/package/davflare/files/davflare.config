config davflare 'main'
	# 总开关；0 = 停用（uci commit davflare && /etc/init.d/davflare restart）
	option enabled '1'

	# 监听端口与地址
	option port '8087'
	option host '0.0.0.0'

	# 数据目录：网盘里看到的文件都放这里。
	# 默认在 overlay（路由器闪存）上，正式使用请改成外置存储挂载点，
	# 例如 option data_dir '/mnt/sda1/davflare'
	option data_dir '/srv/davflare/files'

	# 状态目录：meta（对象元数据）与 tmp（分块上传暂存）都放在这里，
	# 需要与 data_dir 同一个存储，否则大文件上传会撑爆闪存。
	option state_dir '/srv/davflare'
	# 留空 = $state_dir/meta、$state_dir/tmp；需要分开存放时可以单独指定
	option meta_dir ''
	option tmp_dir ''

	# WebDAV / 管理后台账号（鉴权是 fail-closed：密码为空时全部拒绝）
	option username 'admin'
	option password ''

	# 是否允许匿名只读访问整个网盘
	option public_read '0'

	# 匿名只读 WebDAV 目录（网盘根目录下的文件夹名，留空 = 关闭）
	option public_dir ''
	# 上面那个目录的生效开关：关掉即可立刻停用，同时保留目录名配置
	option public_dir_on '1'

	# 是否允许被 iframe 内嵌（1 = 允许，默认 DENY）
	option allow_iframe '0'

	# 是否把每个请求写进日志（排障用，日常建议关）
	option log '0'

	# 单次请求体上限（字节）；0 = 不限制（只受磁盘容量约束）
	option max_request_bytes '0'

	# 传给 Node 的启动参数（按空格拆分成多个参数）。
	# 路由器内存有限时建议收紧 V8 堆上限，例如小内存设备填：
	#   option node_options '--max-old-space-size=128 --optimize_for_size'
	option node_options ''

	# 品牌名称（仅首次初始化生效，之后在「设置 → 品牌」里改）
	option brand_name ''

	# 静态站点自定义域名（留空 = 用 IP:端口 直接访问，通常不需要填）
	option sites_host ''

	# 回收站自动清理天数（留空 = 不自动清理）
	option trash_retention_days ''
